---
import type { GitHubProfile } from '../utils/github';

interface Props {
  profile: GitHubProfile;
}

const { profile } = Astro.props;
---

<section class="container mx-auto px-4 py-16 text-center">
  <div class="max-w-2xl mx-auto">
    <img
      src={profile.avatar_url}
      alt={profile.name || profile.login}
      class="w-32 h-32 rounded-full mx-auto mb-6 border-4 border-white shadow-lg"
    />
    <h1 class="text-4xl font-bold mb-2">
      {profile.name || profile.login}
    </h1>
    {profile.bio && (
      <p class="text-xl text-gray-600 mb-4">{profile.bio}</p>
    )}
    <p class="text-gray-500 mb-6">@{profile.login}</p>
    <div class="flex justify-center gap-6 text-sm text-gray-500">
      <span>
        <strong class="text-gray-900">{profile.public_repos}</strong> 仓库
      </span>
      <span>
        <strong class="text-gray-900">{profile.followers}</strong> 关注者
      </span>
      <span>
        <strong class="text-gray-900">{profile.following}</strong> 关注中
      </span>
    </div>
    <a
      href={profile.html_url}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-block mt-6 px-6 py-2 bg-gray-900 text-white rounded-lg hover:bg-gray-700 transition"
    >
      GitHub Profile
    </a>
  </div>
</section>
